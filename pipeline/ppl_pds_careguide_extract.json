          "text" : "DECLARE @P_CALLLIST_DATE DATETIME\n\t\tDECLARE @CALLLIST_IID INT\n\t\tDECLARE @CALLLISTDATE_DATE DATETIME\n\t\t\n\t\tDECLARE @PREV_CALLLISTDATE_DATE DATETIME\n\t\n\t\t\t\n\t\t\tSELECT @CALLLIST_IID = CALLLIST_IID FROM PDS_CALLLIST WHERE CALLLIST_CD = '704'\n\n\t\t\tIF @P_CALLLIST_DATE IS NULL OR @P_CALLLIST_DATE = '1/1/1901'\n\t\t\tSELECT @P_CALLLIST_DATE = CONVERT(DATE,DATEADD(DAY,1,MAX(CALLLISTDATE_DATE))) FROM PDS_CALLLISTDATE WHERE CALLLISTDATE_CALLLIST_IID = @CALLLIST_IID\n\t\t\t\t\n\t\t\tIF @CALLLISTDATE_DATE IS NULL OR @P_CALLLIST_DATE = '1/1/1901'\n\t\t\tSELECT @CALLLISTDATE_DATE = CALLLISTDATE_DATE FROM PDS_CALLLISTDATE WHERE CONVERT(DATE,CASE WHEN DATEPART(HOUR,CALLLISTDATE_DATE)>20 THEN DATEADD(DAY,1,CALLLISTDATE_DATE) ELSE CALLLISTDATE_DATE END) = @P_CALLLIST_DATE AND CALLLISTDATE_CALLLIST_IID = @CALLLIST_IID\t\t\t\t\t\n\t\t\n\n\t\t\tIF (@PREV_CALLLISTDATE_DATE IS NULL OR @P_CALLLIST_DATE = '1/1/1901')\n\t\t\t\n\t\t\tSELECT  MAX(CALLLISTDATE_DATE) FROM PDS_CALLLISTDATE WHERE CALLLISTDATE_CALLLIST_IID = @CALLLIST_IID AND CALLLISTDATE_DATE < @CALLLISTDATE_DATE"
        } ],
