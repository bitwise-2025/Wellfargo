nation_FilePath,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'Flat_File_Source_ContainerName' AND PIPELINE_NAME = 'ETL_SAS_SANDBOX_EXTRACT' AND DATAFLOW_NAME = 'Populate_SAS_Master_List_Temp_Table') AS Populate_SAS_Master_List_Temp_Table_FlatFileSource_ContainerName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'Flat_File_Source_FileName' AND PIPELINE_NAME = 'ETL_SAS_SANDBOX_EXTRACT' AND DATAFLOW_NAME = 'Populate_SAS_Master_List_Temp_Table') AS Populate_SAS_Master_List_Temp_Table_FlatFileSource_FileName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'Flat_File_Source_FilePath' AND PIPELINE_NAME = 'ETL_SAS_SANDBOX_EXTRACT' AND DATAFLOW_NAME = 'Populate_SAS_Master_List_Temp_Table') AS Populate_SAS_Master_List_Temp_Table_FlatFileSource_FilePath,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'OLE_DB_Destination_ContainerName' AND PIPELINE_NAME = 'ETL_SAS_SANDBOX_EXTRACT' AND DATAFLOW_NAME = 'Populate_SAS_Master_List_Temp_Table') AS Populate_SAS_Master_List_Temp_Table_OLEDBDestination_ContainerName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'OLE_DB_Destination_FileName' AND PIPELINE_NAME = 'ETL_SAS_SANDBOX_EXTRACT' AND DATAFLOW_NAME = 'Populate_SAS_Master_List_Temp_Table') AS Populate_SAS_Master_List_Temp_Table_OLEDBDestination_FileName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'OLE_DB_Destination_FilePath' AND PIPELINE_NAME = 'ETL_SAS_SANDBOX_EXTRACT' AND DATAFLOW_NAME = 'Populate_SAS_Master_List_Temp_Table') AS Populate_SAS_Master_List_Temp_Table_OLEDBDestination_FilePath,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'Get_Metadata0_sink_SchemaName' AND PIPELINE_NAME = 'ETL_SAS_SANDBOX_EXTRACT') AS Get_Metadata0_sink_SchemaName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'Get_Metadata0_sink_TableName' AND PIPELINE_NAME = 'ETL_SAS_SANDBOX_EXTRACT') AS Get_Metadata0_sink_TableName,\n(SELECT 