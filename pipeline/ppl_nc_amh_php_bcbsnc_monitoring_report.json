      },
      "SourceQuery" : {
        "type" : "string",
        "defaultValue" : "'SELECT DISTINCT\t'PHP - BCBSNC' AS reportingEntity, \\n\t\tEC.Interface_Id AS [Interface ID],\\n\t\tEC.Interface_Name AS [Interface Name], \\n\t\t'PHP - BCBSNC' AS [Source],\\n\t\t'CCNC' AS [Target],\\n\t\tCASE WHEN EC.Extract_Config_Code LIKE '%L' THEN 'Weekly' ELSE 'Daily' END AS [Frequency],\\n\t\t'Sending Entity' AS [Sent/Received],\\n\t\t'Success' AS [Status],  \\n\t\t FORMAT(H.EXTRACT_HISTORY_COMPLETION_TIME,'MM/dd/yyyy hh:mm tt')  AS [Date/Time Sent/Received],\\n\t\t FORMAT(H.EXTRACT_HISTORY_EXECUTION_TIME,'MM/dd/yyyy hh:mm tt')  AS [Process Start Time],\\n\t\t FORMAT(H.EXTRACT_HISTORY_COMPLETION_TIME,'MM/dd/yyyy hh:mm tt') AS [Process End Time],\\n\t\tF.[Extract_History_File_Size] AS [File Size], \t\\n\t\tF.EXTRACT_HISTORY_FILE_RECORDCOUNT AS [Records Sent/Received],\\n\t\t'(partner leaves blank)' AS [Records Processed (Target Only)],\\n\t\t'(partner leaves blank)' AS [Error Count (Target Only)] \\n\\n\tFROM DATA_EXCHANGE.EXTRACT.NC_AMH_EXTRACT_HISTORY H\t\\n\tINNER JOIN DATA_EXCHANGE.EXTRACT.NC_AMH_EXTRACT_HISTORY_FILES F ON H.EXTRACT_HISTORY_IID = F.EXTRACT_HISTORY_IID\\n\t    \\n\t\tAND H.EXTRACT_HISTORY_COMPLETION_TIME BETWEEN cast('2026-07-27 00:00:00' as datetime) AND cast('7/27/2026 8:05:18 PM' as datetime) AND H.EXTRACT_HISTORY_COMPLETION_TIME IS NOT NULL\\n\t\tAND H.EXTRACT_CONFIG_CODE IN ('MED_P_T', 'MED_I_T', 'NCPDP_T', 'MED_P_L', 'MED_I_L', 'NCPDP_L', 'DEN_L' )\\n\t\tAND F.Extract_History_File_Recipient IN ( 'LHD', 'N3CN' )\\n\t\tAND (Extract_History_File_FileName LIKE 'NCMT_MEDENCCLMPHD%'\\n\t\tOR Extract_History_File_FileName LIKE 'NCMT_MEDENCCLMIHD%'\\n\t\tOR Extract_History_File_FileName LIKE 'NCMT_RXENCHD%'\\n\t\tOR Extract_History_File_FileName LIKE 'NCMT_DENCLMHD%')\\n\t \\n\tINNER JOIN DATA_EXCHANGE.[EXTRACT].[NC_Extract_Config] EC ON  EC.[Extract_Config_Code] = H.[Extract_Config_Code]\\n\t \\n\t UNION ALL\\n\\n\\nSELECT DISTINCT\t'PHP - BCBSNC' AS reportingEntity, \\n\t\tEC.Interface_Id AS [Interface ID],\\n\t\tEC.Interface_Name AS [Interface Name], \\n\t\tNULL AS [Source],\\n\t\tNULL AS [Target],\\n\t\tNULL AS [Frequency],\\n\t\tNULL AS [Sent/Received],\\n\t\t NULL AS [Status],  \\n\t\t NULL  AS [Date/Time Sent/Received],\\n\t\t NULL  AS [Process Start Time],\\n\t\t NULL AS [Process End Time],\\n\t\t NULL AS [File Size], \t\\n\t\t NULL AS [Records Sent/Received],\\n\t\t'(partner leaves blank)' AS [Records Processed (Target Only)],\\n\t\t'(partner leaves blank)' AS [Error Count (Target Only)] \\n\\n\tFROM DATA_EXCHANGE.EXTRACT.NC_AMH_EXTRACT_HISTORY H\t\\n\tINNER JOIN DATA_EXCHANGE.EXTRACT.NC_AMH_EXTRACT_HISTORY_FILES F ON H.EXTRACT_HISTORY_IID = F.EXTRACT_HISTORY_IID\\n\t  \tAND H.EXTRACT_CONFIG_CODE IN  ('MED_P_T', 'MED_I_T', 'NCPDP_T', 'MED_P_L', 'MED_I_L', 'NCPDP_L', 'DEN_L' )\\n\t\tAND F.Extract_History_File_Recipient IN ( 'LHD', 'N3CN' )\\n\t\tAND (Extract_History_File_FileName LIKE 'NCMT_MEDENCCLMPHD%'\\n\t\tOR Extract_History_File_FileName LIKE 'NCMT_MEDENCCLMIHD%'\\n\t\tOR Extract_History_File_FileName LIKE 'NCMT_RXENCHD%'\\n\t\tOR Extract_History_File_FileName LIKE 'NCMT_DENCLMHD%')\\n\t \\n\tINNER JOIN DATA_EXCHANGE.[EXTRACT].[NC_Extract_Config] EC ON  EC.[Extract_Config_Code] = H.[Extract_Config_Code]\\n\t   AND NOT EXISTS ( SELECT H.* \tFROM DATA_EXCHANGE.EXTRACT.NC_AMH_EXTRACT_HISTORY H\t\\n\t\t\t\t\t    INNER JOIN DATA_EXCHANGE.EXTRACT.NC_AMH_EXTRACT_HISTORY_FILES F ON H.EXTRACT_HISTORY_IID = F.EXTRACT_HISTORY_IID\\n\t    \\n\t\t\t\t\t\tAND H.EXTRACT_HISTORY_COMPLETION_TIME BETWEEN cast('2026-07-27 00:00:00' as datetime) AND cast('7/27/2026 8:05:18 PM' as datetime) AND H.EXTRACT_HISTORY_COMPLETION_TIME IS NOT NULL\\n\t\t\t\t\t\tAND H.EXTRACT_CONFIG_CODE IN ('MED_P_T', 'MED_I_T', 'NCPDP_T', 'MED_P_L', 'MED_I_L', 'NCPDP_L', 'DEN_L' )\\n\t\t\t\t\t\tAND F.Extract_History_File_Recipient IN ( 'LHD', 'N3CN' )\\n\t\t\t\t\t\tAND (Extract_History_File_FileName LIKE 'NCMT_MEDENCCLMPHD%'\\n\t\t\t\t\t\tOR Extract_History_File_FileName LIKE 'NCMT_MEDENCCLMIHD%'\\n\t\t\t\t\t\tOR Extract_History_File_FileName LIKE 'NCMT_RXENCHD%'\\n\t\t\t\t\t\tOR Extract_History_File_FileName LIKE 'NCMT_DENCLMHD%')\\n\t\t\t\t\t\tINNER JOIN DATA_EXCHANGE.[EXTRACT].[NC_Extract_Config] EC ON  EC.[Extract_Config_Code] = H.[Extract_Config_Code]\\n\t\t\t\t\t\t)\\n\t  \\nORDER BY  [Date/Time Sent/Received],EC.Interface_Name'"
