          "text" : "DECLARE @grgr_ck VARCHAR(10) = @GRGR_CK\n\nINSERT INTO [dbo].[A2AMonthlyClaimsImportHistory]\nSELECT DISTINCT\n\t MEMBER_ID\n\t,SUBSC_DEPENDENT_INDICATOR \n\t,SUBSC_FIRST_NAME \n\t,SUBSC_LAST_NAME \n\t,MBR_RLTNSHP_CD \n\t,CLCL_ID AS CLAIM_ID\n\t,CHARGE_AMOUNT\n\t,PAID_AMOUNT\n\t,PAID_DT\n\t,GRGR_CK\n\t,SOURCE_SYSTEM\n\t,CLAIM_TYPE        \n   \t,CLCL_LOW_SVC_DT AS FROM_DATE\n\t,MECB_POLICY_ID AS POLICY_ID\n\t,MEME_CK\n\t,FORMAT(GETDATE(),'yyyyMMdd') AS RUNDATE\n\t,FORMAT(GETDATE(),'HHmmss') AS RUNTIMESTAMP\nFROM [dbo].[A2AMonthlyClaimsImport]\nWHERE GRGR_CK = @grgr_ck\n"
