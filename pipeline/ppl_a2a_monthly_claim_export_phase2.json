      "typeProperties" : {
        "scripts" : [ {
          "type" : "Query",
          "text" : "-- =============================================================================================\n-- Update EDI_Config table to start 837 Process --SNOW-50165 (03/07/2022 A2A Phase-1)\n-- =============================================================================================\n\nDECLARE @source_sytem VARCHAR(15), \n\t\t@grgr_ck VARCHAR(15), \n\t\t@claim_type VARCHAR(5),\n\t\t@sql VARCHAR(MAX)\n\nSET @grgr_ck = @GRGR_CK\n\n--Update Completion date in SelectionCriteria Table\nUPDATE DX_EDI.DBO.EDI_A2A_SelectionCriteria SET Value2 = FORMAT(GETDATE(),'yyyyMMdd') WHERE CodeType = 'MarketCode' AND GRGR_CK = @grgr_ck\n\nDECLARE CUR_GETPROCESS_DETAILS CURSOR FOR \n\nSELECT DISTINCT SOURCE_SYSTEM, CLAIM_TYPE \nFROM DX_EDI.[dbo].[A2AMonthlyClaimsImport]\nWHERE GRGR_CK = @grgr_ck;\n\nOPEN CUR_GETPROCESS_DETAILS \nFETCH NEXT FROM CUR_GETPROCESS_DETAILS INTO @source_sytem, @claim_type\n\n/*Updating EDIConfig Table for each ConfigID */\nWHILE @@FETCH_STATUS = 0  \nBEGIN    \n\tSET\t@sql = 'UPDATE DX_EDI.DBO.EDICONFIG SET RunNow=1 \n\t\t\t\tWHERE GRGR_CKs = '''+ @grgr_ck +'''\t-- LIKE ''%'+ @grgr_ck +'%''  /*SNOW-62576*/ \n\t\t\t\tAND  ProcessName LIKE ''%A2A%''\n\t\t\t\tAND  ProcessName LIKE ''%'+@source_sytem+ '%'' \n\t\t\t\tAND WorkflowName LIKE ''%'+@claim_type +''''\n\tEXEC(@sql);\n\n\tFETCH NEXT FROM CUR_GETPROCESS_DETAILS INTO @source_sytem, @claim_type\nEND\nCLOSE CUR_GETPROCESS_DETAILS;\nDEALLOCATE CUR_GETPROCESS_DETAILS;\n\n"
        } ],
        "scriptBlockExecutionTimeout" : null
      }
