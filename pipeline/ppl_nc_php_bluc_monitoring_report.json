      "SourceQuery" : {
        "type" : "string",
        "defaultValue" : "'SELECT DISTINCT\t'BLUC' AS reportingEntity, \\n        EC.Interface_Id AS [Interface ID],\\n        EC.Interface_Name AS [Interface Name], \\n        'BLUC' AS [Source],\\n        'CCNC' AS [Target],\\n        'Daily' AS [Frequency],\\n        'Outbound' AS [Sent/Received],\\n        'Success' AS [Status],  \\n        FORMAT(H.EXTRACT_HISTORY_COMPLETION_TIME,'MM/dd/yyyy hh:mm tt')  AS [Date/Time Sent/Received],\\n        FORMAT(H.EXTRACT_HISTORY_EXECUTION_TIME,'MM/dd/yyyy hh:mm tt')  AS [Process Start Time],\\n        FORMAT(H.EXTRACT_HISTORY_COMPLETION_TIME,'MM/dd/yyyy hh:mm tt') AS [Process End Time],\\n        F.[Extract_History_File_Size] AS [File Size], \t\\n        F.EXTRACT_HISTORY_FILE_RECORDCOUNT AS [Records Sent/Received],\\n        '(partner leaves blank)' AS [Records Processed (Target Only)],\\n        '(partner leaves blank)' AS [Error Count (Target Only)]\\n \\nFROM DATA_EXCHANGE.EXTRACT.NC_AMH_EXTRACT_HISTORY H\t\\nINNER JOIN DATA_EXCHANGE.EXTRACT.NC_AMH_EXTRACT_HISTORY_FILES F ON H.EXTRACT_HISTORY_IID = F.EXTRACT_HISTORY_IID\\n    AND H.EXTRACT_HISTORY_COMPLETION_TIME BETWEEN cast('2026-07-27 00:00:00' as datetime) AND cast('7/27/2026 8:05:20 PM' as datetime) AND H.EXTRACT_HISTORY_COMPLETION_TIME IS NOT NULL\\n    AND H.EXTRACT_CONFIG_CODE IN ('MED_P_TF', 'MED_I_TF', 'NCPDP_TF' )\\n    AND F.Extract_History_File_Recipient IN ( 'N3CN' )\\n    AND (Extract_History_File_FileName LIKE 'NCMT_MEDENCCLMPHD%'\\n        OR Extract_History_File_FileName LIKE 'NCMT_MEDENCCLMIHD%'\\n        OR Extract_History_File_FileName LIKE 'NCMT_RXENCHD%')\\nINNER JOIN DATA_EXCHANGE.[EXTRACT].[NC_Extract_Config] EC ON EC.[Extract_Config_Code] = H.[Extract_Config_Code]\\n \\nUNION ALL\\n\\nSELECT DISTINCT\t'BLUC' AS reportingEntity, \\n        EC.Interface_Id AS [Interface ID],\\n        EC.Interface_Name AS [Interface Name], \\n        NULL AS [Source],\\n        NULL AS [Target],\\n        NULL AS [Frequency],\\n        NULL AS [Sent/Received],\\n        NULL AS [Status],  \\n        NULL AS [Date/Time Sent/Received],\\n        NULL AS [Process Start Time],\\n        NULL AS [Process End Time],\\n        NULL AS [File Size], \t\\n        NULL AS [Records Sent/Received],\\n        '(partner leaves blank)' AS [Records Processed (Target Only)],\\n        '(partner leaves blank)' AS [Error Count (Target Only)]\\n \\nFROM DATA_EXCHANGE.[EXTRACT].[NC_Extract_Config] EC\\nWHERE EC.Extract_Config_Code IN ('MED_P_TF', 'MED_I_TF', 'NCPDP_TF' )\\n    AND NOT EXISTS (\\n        SELECT 1\\n        FROM DATA_EXCHANGE.EXTRACT.NC_AMH_EXTRACT_HISTORY H\t\\n        INNER JOIN DATA_EXCHANGE.EXTRACT.NC_AMH_EXTRACT_HISTORY_FILES F  ON H.EXTRACT_HISTORY_IID = F.EXTRACT_HISTORY_IID\\n        WHERE H.Extract_Config_Code = EC.Extract_Config_Code\\n            AND H.EXTRACT_HISTORY_COMPLETION_TIME BETWEEN cast('2026-07-27 00:00:00' as datetime) AND cast('7/27/2026 8:05:20 PM' as datetime) AND H.EXTRACT_HISTORY_COMPLETION_TIME IS NOT NULL\\n            AND F.Extract_History_File_Recipient IN ( 'N3CN' )\\n            AND (F.Extract_History_File_FileName LIKE 'NCMT_MEDENCCLMPHD%'\\n                OR F.Extract_History_File_FileName LIKE 'NCMT_MEDENCCLMIHD%'\\n                OR F.Extract_History_File_FileName LIKE 'NCMT_RXENCHD%')\\n    )\\n \\nORDER BY [Date/Time Sent/Received], [Interface Name]'"
