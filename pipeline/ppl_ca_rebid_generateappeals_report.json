          "text" : "DECLARE @VendorInboundFileName VARCHAR(256)\n\nDECLARE @OVR_INBOUND_FILENAME VARCHAR(256)\n\n\n\n\n\nSET @OVR_INBOUND_FILENAME = @0\n\n\n\n\nIF(@OVR_INBOUND_FILENAME ='') \nBEGIN\n\n\tSELECT TOP 1 @VendorInboundFileName = INBOUNDFILE_FILENAME FROM EXTRACT.CA_REBID_INBOUND_DETAILS WHERE INBOUNDFILE_FILETYPE = 'STATEFILE' ORDER BY INBOUNDFILE_FILEDATE DESC\n\n\t--SELECT DISTINCT @VendorInboundFileName = vendorfilename from odw.[DW].[VLM_CA_TOC_CIN_LIST] with(nolock) \n\t--where CAST(LASTUPDTDTM AS DATE) >= DATEADD(d, 3, DATEADD(wk,DATEDIFF(wk,7,getdate()),-1))\n\t\n END\n \n\nELSE \nBEGIN\t\n\n\tSET @VendorInboundFileName = @OVR_INBOUND_FILENAME\n END\n\n\nSELECT @VendorInboundFileName AS VendorInboundFileName "
