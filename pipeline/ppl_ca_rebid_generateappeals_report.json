      "typeProperties" : {
        "scripts" : [ {
          "type" : "Query",
          "text" : "\nDECLARE @FILE_TYPE VARCHAR(30)\nSET @FILE_TYPE = @Extract_Type\n\nIF EXISTS(SELECT * FROM EXTRACT.CA_REBID_FILE_COUNTS WHERE FILEEXPORT_FILETYPE = @FILE_TYPE AND FILEEXPORT_EXPORTDATE > DATEADD(day, -2, CONVERT (date, GETDATE())))\nBEGIN\n DELETE FROM EXTRACT.CA_REBID_FILE_COUNTS WHERE FILEEXPORT_FILETYPE = @FILE_TYPE AND FILEEXPORT_EXPORTDATE > DATEADD(day, -2, CONVERT (date, GETDATE()))\nEND\n\nIF EXISTS(SELECT * FROM EXTRACT.CA_REBID_FILE_COUNTS WHERE FILEEXPORT_FILETYPE = @FILE_TYPE AND FILEEXPORT_EXPORTDATE < DATEADD(day, -30, CONVERT (date, GETDATE())))\nBEGIN\n\n DELETE FROM EXTRACT.CA_REBID_FILE_COUNTS WHERE FILEEXPORT_FILETYPE = @FILE_TYPE AND FILEEXPORT_EXPORTDATE < DATEADD(day, -30, CONVERT (date, GETDATE()))\nEND\n\nIF EXISTS (SELECT * FROM EXTRACT.CA_REBID_FILES WHERE file_type = @FILE_TYPE AND Submission_Date > DATEADD(day, -2, CONVERT (date, GETDATE())))\nBEGIN\n\n DELETE FROM EXTRACT.CA_REBID_FILES WHERE file_type = @FILE_TYPE AND Submission_Date > DATEADD(day, -2, CONVERT (date, GETDATE()))\nEND\n\nIF EXISTS(SELECT * FROM EXTRACT.CA_REBID_FILES WHERE file_type = @FILE_TYPE AND Submission_Date < DATEADD(day, -30, CONVERT (date, GETDATE())))\nBEGIN\n DELETE FROM EXTRACT.CA_REBID_FILES WHERE file_type = @FILE_TYPE AND Submission_Date < DATEADD(day, -30, CONVERT (date, GETDATE()))\nEND"
