          "value" : "@concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat('Hello, the MO Member lead results have been loaded to the EPSDTWellServices table in the source server.  Refresh of this data to DWA1P occurs on the 5th of the month. ','\"\n\nRecords Received in File : \"'),variables('SourceFileRecordCount')),'\"\n\nRecords Imported to EPSDTWellServices table: \"'),variables('ImportRecordCount')),'\"\n\nNote: Records that are not imported are due to the record already existing in EPSDTWellServices, Medicaid ID not found in FACETS or Invalid Specimen collection date. \"'),'\"\n\nDate & Time: \"'),notConvertedectfunctiondatedatepart('YEAR', formatDateTime(utcnow(),'M/d/yyyy hh:mm:ss tt'))),'-'),(if(notConvertedectfunctiondatedatepart('MONTH', formatDateTime(utcnow(),'M/d/yyyy hh:mm:ss tt')) < 10, '0', ''))),notConvertedectfunctiondatedatepart('MONTH', formatDateTime(utcnow(),'M/d/yyyy hh:mm:ss tt'))),'-'),(if(notConvertedectfunctiondatedatepart('DAY', formatDateTime(utcnow(),'M/d/yyyy hh:mm:ss tt')) < 10, '0', ''))),notConvertedectfunctiondatedatepart('DAY', formatDateTime(utcnow(),'M/d/yyyy hh:mm:ss tt'))),' at '),(if(notConvertedectfunctiondatedatepart('HOUR', formatDateTime(utcnow(),'M/d/yyyy hh:mm:ss tt')) < 10, '0', ''))),notConvertedectfunctiondatedatepart('HOUR', formatDateTime(utcnow(),'M/d/yyyy hh:mm:ss tt'))),':'),(if(notConvertedectfunctiondatedatepart('MINUTE', formatDateTime(utcnow(),'M/d/yyyy hh:mm:ss tt')) < 10, '0', ''))),notConvertedectfunctiondatedatepart('MINUTE', formatDateTime(utcnow(),'M/d/yyyy hh:mm:ss tt'))),':'),(if(notConvertedectfunctiondatedatepart('SECOND', formatDateTime(utcnow(),'M/d/yyyy hh:mm:ss tt')) < 10, '0', ''))),notConvertedectfunctiondatedatepart('SECOND', formatDateTime(utcnow(),'M/d/yyyy hh:mm:ss tt')))",
