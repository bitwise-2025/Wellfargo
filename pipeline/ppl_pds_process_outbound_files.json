          "sqlReaderStoredProcedureName" : null,
          "sqlReaderQuery" : "SELECT\n\tCALLLIST_CD\nFROM\n\tPDS_CALLLIST\nINNER JOIN PDS_CALLLISTDATE\n\tON CALLLISTDATE_CALLLIST_IID = CALLLIST_IID\n\tAND CALLLISTDATE_PROCESS_DT IS NULL\nWHERE\n\tCALLLIST_ACTIVELIST_IND = 1\nGROUP BY CALLLISTTYPE_IID, CALLLIST_CD\nORDER BY\n\tCALLLISTTYPE_IID, CALLLIST_CD desc \n/*cnr 17088 - changed \"order by\" 12-02-2009 */",
