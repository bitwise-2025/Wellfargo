        "source" : {
          "type" : "AzureSqlsource",
          "sqlReaderQuery" : "SELECT CL.CALLLIST_CD,ISNULL(UJ.PROGRAM_CD,'') AS PRODUCT_CD,COUNT(DISTINCT CM.CALLLISTMASTER_ENTITY_IID) AS PRE_SCRUB_MEMBERS AS PRE_SCRUB_MEMBERS_R8,COUNT(DISTINCT (CASE WHEN CM.CALLLISTMASTER_ACTIVE_IND = 1 THEN CM.CALLLISTMASTER_ENTITY_IID END)) AS POST_SCRUB_MEMBERS AS POST_SCRUB_MEMBERS_R8 ,CAST(CALLLIST_CD as VARCHAR) AS CALLLIST_CD_Unicode,CAST(PRODUCT_CD as VARCHAR) AS PRODUCT_CD_Unicode FROM PDS_CALLLIST CL INNER JOIN PDS_CALLLISTDATE CD ON CL.CALLLIST_IID = CD.CALLLISTDATE_CALLLIST_IID AND CL.CALLLIST_CD IN ('201','301') AND MONTH(CONVERT(DATETIME,CONVERT(DATE,CASE WHEN DATEPART(HOUR,CD.CALLLISTDATE_DATE)>22 THEN DATEADD(DAY,1,CD.CALLLISTDATE_DATE) ELSE CD.CALLLISTDATE_DATE END))) = MONTH(@REPORTDATE) AND YEAR(CONVERT(DATETIME,CONVERT(DATE,CASE WHEN DATEPART(HOUR,CD.CALLLISTDATE_DATE)>22 THEN DATEADD(DAY,1,CD.CALLLISTDATE_DATE) ELSE CD.CALLLISTDATE_DATE END))) = YEAR(@REPORTDATE) AND CONVERT(DATETIME,CONVERT(DATE,CASE WHEN DATEPART(HOUR,CD.CALLLISTDATE_DATE)>22 THEN DATEADD(DAY,1,CD.CALLLISTDATE_DATE) ELSE CD.CALLLISTDATE_DATE END)) <= @REPORTDATE INNER JOIN PDS_CALLLISTMASTER CM ON CD.CALLLISTDATE_IID = CM.CALLLISTMASTER_CALLLISTDATE_IID INNER JOIN PDS_RPT_UNITJOB UJ ON CM.CALLLISTMASTER_UNITJOB_IID = UJ.UNITJOB_IID AND UJ.PLAN_CD = 'NY' INNER JOIN PDS_CALLLISTRULE LCR ON CM.CALLLISTMASTER_LOAD_CALLLISTRULE_IID = LCR.CALLLISTRULE_IID AND LCR.CALLLISTRULE_CD <> 'PREVRUN' GROUP BY CL.CALLLIST_CD,ISNULL(UJ.PROGRAM_CD,'') ORDER BY CONVERT(INT,CL.CALLLIST_CD)"
