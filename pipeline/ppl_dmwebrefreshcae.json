E FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'Data_Flow_-_Member01_sink_SchemaName' AND PIPELINE_NAME = 'DmwebRefreshCae' AND DATAFLOW_NAME = 'Data_Flow_-_Member01') AS Data_Flow_-_Member01_sink_SchemaName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'Data_Flow_-_Member01_sink_TableName' AND PIPELINE_NAME = 'DmwebRefreshCae' AND DATAFLOW_NAME = 'Data_Flow_-_Member01') AS Data_Flow_-_Member01_sink_TableName;",
