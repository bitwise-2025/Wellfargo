      "typeProperties" : {
        "scripts" : [ {
          "type" : "Query",
          "text" : "--ctrak member (not yet in facet) that has matching subscriberid\nUPDATE M SET hasCaeSubscriberId = 1\nFROM Member.Member M\nINNER JOIN Staging.CaeMember C ON C.subscriberId = M.subscriberId\nWHERE M.facetMemberId IS NULL\n\tAND ISNULL(M.subscriberId,'') <> ''\n\n--ctrak member (not yet in facet) that has no subscriberid\nUPDATE M SET hasCaeSubscriberId = 0\nFROM Member.Member M\nINNER JOIN Staging.CaeMember C ON C.subscriberId = M.subscriberId\nWHERE M.facetMemberId IS NULL\n\tAND ISNULL(M.subscriberId,'') = ''\n\n--facetmember (assumes facetmemberid and subscriber are synced)\nUPDATE M SET \n\thasCaeSubscriberId = \n\t\tCASE WHEN C.facetMemberId = M.facetMemberId AND C.subscriberId = M.subscriberId\n\t\tTHEN 1 ELSE 0 END\nFROM Member.Member M\nLEFT JOIN Staging.CaeMember C ON C.facetMemberId = M.facetMemberId\nWHERE M.facetMemberId IS NOT NULL\n\tAND M.hasCaeSubscriberId IS NULL\n"
        } ],
        "scriptBlockExecutionTimeout" : null
