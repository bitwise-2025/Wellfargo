          "typeProperties" : {
            "scripts" : [ {
              "type" : "Query",
              "text" : "DECLARE @tableHTML NVARCHAR(MAX) ;\nDECLARE @CountRequests int\nSET @CountRequests = @ApprovalEmailRecipients\n\nIF @CountRequests = 0\n   BEGIN\n    SET @tableHTML =\n   \t N'<html><body><font face=\"Tahoma\">' +\n    \tN'<h5>There were no new files created today.</h5>' +\n\t'</font></body></font></html>'\n   END\nELSE\n   BEGIN\n    SET @tableHTML =\n    N'<html><body><font face=\"Tahoma\"><h4>Total Counts By Request</h4>' +\n    N'<table border=\"1\" width=\"100%\">' +\n    N'<font face=\"Tahoma\"><tr bgcolor=\"#99CCFF\"><td>RequestID</td><td>Vendor</td><td>ApplicationName</td><td>Group ID</td><td>Records Created</td><td>Records Approved</td></tr>' +\n            CAST((\n        SELECT\n                    td = R.RequestID, '',\n\t\t\t\t\ttd=  R.Vendor, '',\n                    td = R.ApplicationName, '',\n                    td = CASE WHEN R.GroupID IS NULL THEN 'XX' ELSE R.GroupID END, '',\n                    td = RS.RecordsCreated, '',\n                    td = RS.RecordsApproved, ''\n            FROM dbo.Requests R\n\t\t\tINNER JOIN dbo.RequestSummary RS\n\t\t\t\tON R.RequestID = RS.RequestID\n\t\t\tWHERE RS.CreateDate >= @CountRequests\n\tORDER BY R.RequestID\n                    FOR XML PATH('tr'), TYPE) AS NVARCHAR(MAX)) + N'</table></font></body></font></html>'\n   END\n\n\n\nEXEC msdb.dbo.sp_send_dbmail \n\t@recipients=@StartDateTime\n\t, @subject = 'Daily Vendor Files Created - Pending'\n\t, @body = @tableHTML\t\n\t, @body_format = 'HTML'\n\n"
            } ],
            "scriptBlockExecutionTimeout" : null
          }
        } ]
