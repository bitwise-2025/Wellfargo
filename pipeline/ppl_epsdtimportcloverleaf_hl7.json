      "typeProperties" : {
        "scripts" : [ {
          "type" : "Query",
          "text" : "DECLARE @JobId INT\nDECLARE @JobCode VARCHAR(8000)\nDECLARE @EnvironName VARCHAR(8000)\nDECLARE @RootPath VARCHAR(8000)\nDECLARE @FolderPath VARCHAR(8000)\nDECLARE @ArchiveFolderPath VARCHAR(8000)\nDECLARE @LogFileName VARCHAR(8000)\nDECLARE @ArchiveFileNamePrefix VARCHAR(8000)\nDECLARE @TidalJobNumber VARCHAR(8000)\nDECLARE @TempTidalJobNumber VARCHAR(8000)\n\nDECLARE @ProcessJob VARCHAR(1)\n\nSET @JobCode = @0\nSET @JobID = (SELECT JobID FROM EPSDTJob Where JobCode = @JobCode)\nSET @TidalJobNumber = @1\n\nSET @EnvironName = (SELECT Value FROM EPSDTAppConfig WHERE ConfigKey = 'Environment')\nSET @RootPath = (SELECT Value FROM EPSDTJobConfig WHERE ConfigKey = 'RootPath' AND JobID = @JobID)\n\n--if dev and running from visualstudio (instead of tidal), then put D in front\nIF @EnvironName = 'Dev' AND @TidalJobNumber LIKE 'D%'\nBEGIN\n\tSET @TempTidalJobNumber = (SELECT MAX(TidalJobNumber) FROM EPSDTJobFile WHERE TidalJobNumber LIKE 'D%')\n\tSET @TidalJobNumber = 'D' + LTRIM(RTRIM(STR(ISNULL(CONVERT(INT, REPLACE(@TempTidalJobNumber, 'D', '')) + 1, 1))))\nEND\n\n\nSET @FolderPath = @RootPath + @EnvironName + (SELECT Value FROM EPSDTJobConfig WHERE JobId = @JobID AND ConfigKey = 'FolderPath')\nSET @LogFileName = (SELECT Value FROM EPSDTJobConfig WHERE JobId = @JobId AND ConfigKey = 'LogFileName')\nSET @ArchiveFileNamePrefix = (SELECT Value FROM EPSDTJobConfig WHERE JobId = @JobID AND ConfigKey = 'ArchiveFileNamePrefix')\nSET @ArchiveFolderPath = @RootPath + @EnvironName + '\\Archive' + (SELECT Value FROM EPSDTJobConfig WHERE JobId = @JobID AND ConfigKey = 'FolderPath')\nSET @ArchiveFileNamePrefix = REPLACE(@ArchiveFileNamePrefix, '{&tidalJobNumber}', @TidalJobNumber)\nSET @LogFileName = REPLACE(@LogFileName, '{&tidalJobNumber}', @TidalJobNumber)\n\n\nSELECT\n\t JobId = @JobId\n\t,FolderPath = @FolderPath\n\t,FilePattern = (SELECT Value FROM EPSDTJobConfig WHERE JobId = @JobId AND ConfigKey = 'FilePattern')\n\t,Delimiter = (SELECT Value FROM EPSDTJobConfig WHERE JobId = @JobId AND ConfigKey = 'Delimiter')\n\t,ArchiveFolderPath =  @ArchiveFolderPath\n\t,ArchiveFileNamePrefix = @ArchiveFileNamePrefix\n\t,LogFileName =  @ArchiveFolderPath +  @LogFileName\n\t,TidalJobNumber = @TidalJobNumber\n\t,ProcessJob = @ProcessJob"
