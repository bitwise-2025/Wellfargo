        "scripts" : [ {
          "type" : "Query",
          "text" : "IF OBJECT_ID('tempdb..##report') IS NOT NULL DROP TABLE ##report\n\nDeclare @time varchar(20)\nDeclare @hour int\nDeclare @minutes int\nDeclare @meridian varchar(20)\n\nSELECT  @hour = FORMAT(getdate(),'hh')\nSELECT  @minutes = FORMAT(GETDATE(),'mm')\nSELECT @meridian=FORMAT(GETDATE(),'tt')\n\n\nIF (@minutes >= 30)\n       SET @time = cast(@hour as varchar(10)) + ':30 ' + @meridian  \nELSE\n       SET @time = cast(@hour as varchar(10)) + ':00 ' + @meridian  \n\n--SELECT @time\n\nSELECT \na.reportId\n,a.reportName\n,a.deliveryLocation\n,a.reportNetworkLocation\n,a.fileFormatConfigId\n,a.deliveryMethodConfigId\n,a.fileFormatConfigName\n,a.deliveryMethodConfigName\n,a.reportScheduleId\n,a.startDate\n,a.endDate\n,a.frequency\n,a.frequencyConfigName\n,a.timeslot\n,a.timeslotConfigName\n,a.ntid,b.[reportCatConfigId]\n  \ninto ##report\nFROM Report.vwCraReportSchedule a\njoin [Report].[Report] b\non a.reportid=b.reportid\nwhere GETDATE() BETWEEN startDate AND endDate \nand frequencyconfigName LIKE '%' + FORMAT(GETDATE(),'dddd') + '%' \nand timeslotconfigName LIKE '%' +@time +'%'\nand b.[reportCatConfigId]<>631"
