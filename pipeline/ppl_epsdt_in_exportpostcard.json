          "type" : "Parquetsource",
          "sqlReaderQuery" : "SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED \tDECLARE @CURRENT_DATE AS DATETIME; \tSET @CURRENT_DATE = GETDATE(); \t\t\t SELECT\tDISTINCT  \t\t\t SBSB.SBSB_ID + '00' MEMBER                 \t\t\t,MEME.MEME_MEDCD_NO 'ALTKEY' \t\t\t,MEME.MEME_LAST_NAME \t\t\t,MEME.MEME_FIRST_NAME \t\t\t,MEPE.PDPD_ID \t\t\t,MEPE.CSCS_ID \t\t\t,CSPI.PLAN_IDENTIFIER FROM\t\t(SELECT GRGR_CK, PDPD_ID, CSPI_ID, CSCS_ID,                 CASE \t\t\t\tWHEN PDPD_ID  IN ('INPLUS00','INPLUS01','INTEMP00')\t\t\t\t\t\t\t\t\t THEN 'HCC' \t\t\t\tWHEN PDPD_ID  IN ('INBASCH0','INBASCHR','INBASI1R','INBASIC0','INBASIC1','INBASICR') THEN 'HHW' \t\t\t\tWHEN PDPD_ID  IN ('INHIPBA0','INHIPBA1','INHIPBA2','INHIPBA3','INHIPBA4','INHIPPL0', \t\t\t\t\t\t\t\t  'INHIPPL2','INHIPPL3','INHIPPL4','INHIPPRE','INHPEBAR','INHPEBAS', \t\t\t\t\t\t\t\t  'INHPEBAT','INHPEBAU','INHPSPB0','INHPSPB2','INHPSPB3','INHPSPB4', \t\t\t\t\t\t\t\t  'INHPSPP0','INHPSPP2','INHPSPP3','INHPSPP4','INTEMP01')\t\t\t THEN 'HIP'  \t\t\t         ELSE 'OTH' END 'PLAN_IDENTIFIER'               FROM ODW.DW.FAC_CMC_CSPI_CS_PLAN                WHERE GRGR_CK = 90) CSPI   INNER JOIN\tODW.DW.FAC_CMC_MEPE_PRCS_ELIG  MEPE ON MEPE.GRGR_CK = CSPI.GRGR_CK AND MEPE.PDPD_ID = CSPI.PDPD_ID AND MEPE.CSCS_ID = CSPI.CSCS_ID AND MEPE.MEPE_ELIG_IND = 'Y'  AND\t@CURRENT_DATE BETWEEN MEPE.MEPE_EFF_DT and MEPE.MEPE_TERM_DT  INNER JOIN ODW.DW.FAC_CMC_MEME_MEMBER  MEME ON\t\t\tMEME.MEME_CK = MEPE.MEME_CK AND\t\t\tMEME.GRGR_CK = MEPE.GRGR_CK INNER JOIN  ODW.DW.FAC_CMC_SBSB_SUBSC SBSB   ON\t\t\tMEME.SBSB_CK = SBSB.SBSB_CK  AND\t\t\tMEPE.GRGR_CK = SBSB.GRGR_CK"
