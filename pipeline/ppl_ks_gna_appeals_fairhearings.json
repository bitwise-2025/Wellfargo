          "typeProperties" : {
            "scripts" : [ {
              "type" : "Query",
              "text" : "DECLARE @ACTION VARCHAR(20)\nSET @ACTION= @0\n\nDROP TABLE IF EXISTS #BALANCEANDCONTROL_KS\nCREATE TABLE #BALANCEANDCONTROL_KS\n(\n\t Seq_No int IDENTITY(1,1)\n\t,Report_Type varchar(50)\n\t,Description varchar(500)\n\t,ReportDate  date\n\t,RecordCount int\n)\n;WITH MaxDates AS (\n    SELECT DISTINCT\n        REPORT_Type,\n        REPORT_SUB_TYPE\n    FROM EXTRACT.KS_GandA_ErrorReport\n    GROUP BY REPORT_Type, REPORT_SUB_TYPE\n),\nFilteredData AS (\n    SELECT DISTINCT\n        t.CASEID,\n        t.REPORT_Type,\n        t.REPORT_SUB_TYPE\n    FROM EXTRACT.KS_GandA_ErrorReport t\n    INNER JOIN MaxDates md\n        ON t.REPORT_Type = md.REPORT_Type\n        AND t.REPORT_SUB_TYPE = md.REPORT_SUB_TYPE\n)\nINSERT INTO #BALANCEANDCONTROL_KS\n(Description,RecordCount)\nSELECT \n    CONCAT('Total No. of Records for Appeals for ' , REPORTDATE),\n    COUNT(*) AS RecordCount\nFROM EXTRACT.KS_ConsolidatedAPPEALS\nGROUP BY REPORTDATE\nUNION ALL\nSELECT \n    'No. of Records for ' +\n\tCASE WHEN PROCESS_TYPE = 'APPEALS_MEMPROV' \n\t\t\tTHEN 'MembersProviders Appeals' \n\t     WHEN PROCESS_TYPE = 'APPEALS_RECON' \n\t\t     THEN 'Reconsideration Appeals'\n\t\t WHEN PROCESS_TYPE = 'APPEALS_CPA' \n\t\t     THEN 'Claim Payment Appeals' \n\t\tELSE PROCESS_TYPE END,\n    COUNT(*) AS RecordCount\nFROM EXTRACT.KS_ConsolidatedAPPEALS\nGROUP BY PROCESS_TYPE\n\n\nUNION ALL\n\nSELECT \n    concat('Total No. of Records for FairHearings for ' , REPORTDATE), \n    COUNT(*) AS RecordCount\nFROM EXTRACT.KS_ConsolidatedFairHearings\ngroup by reportdate\nUNION ALL\nSELECT \n    'No. of Records for ' +\n\tCASE WHEN PROCESS_TYPE = 'FH_MEMPROV' \n\t\t\tTHEN 'SFH MembersProviders' \n\t     WHEN PROCESS_TYPE = 'FH_REG' \n\t\t     THEN 'SFH Regulatory Complaint'\n\t\t\t ELSE PROCESS_TYPE END,\n    COUNT(*) AS RecordCount\nFROM EXTRACT.KS_ConsolidatedFairHearings\nGROUP BY PROCESS_TYPE\n\nUNION ALL\n\nSELECT \n    concat('Total No. of Records for Grievances for ',reportdate) ,\n    numberofrecords AS RecordCount\nFROM EXTRACT.KS_GandA_HEADERINFO where Action = @ACTION  and filetype = 'grievances'\n\nUNION ALL\n\n\nSELECT \n    'No. of Records for Grievances ' +\n\tGrievanceType,\n    COUNT(*) AS RecordCount\nFROM EXTRACT.KS_ConsolidatedGRIEVANCES\nGROUP BY GrievanceType\n\nUNION ALL\n\nSELECT \n    'Missing data for ' +CASE WHEN REPORT_TYPE = 'Grievances' THEN REPORT_TYPE+'-'+REPORT_SUB_TYPE ELSE REPORT_SUB_TYPE END,\n    COUNT(*) AS RecordCount\nFROM FilteredData\nGROUP BY REPORT_Type, REPORT_SUB_TYPE\n\ndeclare @tmp varchar(8000) = '' \nSET @tmp = ''\nselect @tmp = @tmp +convert(varchar(15),RecordCount )+'   '+ Description  + Char(13)+ Char(13) from #BALANCEANDCONTROL_KS\nselect SUBSTRING(@tmp, 0, LEN(@tmp)) AS EmailMessage"
            } ],
