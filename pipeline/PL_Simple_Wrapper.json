{
	"name": "PL_Simple_Wrapper",
	"properties": {
		"activities": [
			{
				"name": "Run child",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Simple_Child",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"pBatchId": {
							"value": "@pipeline().parameters.pBatchId",
							"type": "Expression"
						},
						"pTestData": {
							"value": "@json(pipeline().parameters.pTestDataJson)",
							"type": "Expression"
						},
						"pEndCode": {
							"value": "@pipeline().parameters.pEndCode",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Construct Subject",
				"description": "SSIS Script Task 'Construct Subject' (Calypso FX): sSubject = WFSR&S_ProcessAlert_ + sEnvironment + _ + sProcessName",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Run child",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vSubject",
					"value": {
						"value": "@concat('WFSR&S_ProcessAlert_', pipeline().parameters.pEnvironment, '_', pipeline().parameters.pProcessName)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Delete files gate",
				"description": "SSIS Script Task 'Delete CSV files' (1PAAF). Runs only when pDeleteFiles = true.",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Construct Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@pipeline().parameters.pDeleteFiles",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Delete CSV files",
							"type": "Delete",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 30
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "Generic_src_parquet",
									"type": "DatasetReference"
								},
								"enableLogging": false,
								"storeSettings": {
									"type": "AzureBlobStorageReadSettings",
									"recursive": true,
									"wildcardFileName": "*.csv",
									"enablePartitionDiscovery": false
								}
							}
						}
					]
				}
			},
			{
				"name": "Send failure mail",
				"description": "SSIS Send Mail Task 'Failure Mail': subject sSubject + _FAILURE, body sMessage + error.",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Delete files gate",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 2,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().globalParameters.gp_MailLogicAppUrl",
						"type": "Expression"
					},
					"body": {
						"value": "{\"to\":\"@{pipeline().parameters.pMailTo}\",\"cc\":\"@{pipeline().parameters.pMailCc}\",\"from\":\"@{pipeline().parameters.pMailFrom}\",\"importance\":\"High\",\"subject\":\"@{variables('vSubject')}_FAILURE\",\"bodyB64\":\"@{base64(concat(pipeline().parameters.pMessage, decodeUriComponent('%0A'), 'Wrapper run ID: ', pipeline().RunId, decodeUriComponent('%0A'), 'Start time (UTC): ', pipeline().TriggerTime, decodeUriComponent('%0A'), 'Error: ', activity('Run child').error.message))}\"}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Re-raise error",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Send failure mail",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('Run child').error.message",
						"type": "Expression"
					},
					"errorCode": "500"
				}
			}
		],
		"parameters": {
			"pBatchId": {
				"type": "string",
				"defaultValue": "1"
			},
			"pTestDataJson": {
				"type": "string",
				"defaultValue": [
					{
						"TradeId": "T1",
						"Amount": "100"
					}
				]
			},
			"pEndCode": {
				"type": "string",
				"defaultValue": "1"
			},
			"pEnvironment": {
				"type": "string",
				"defaultValue": " - DEV"
			},
			"pProcessName": {
				"type": "string",
				"defaultValue": "CalypsoFXRevenueShareETL"
			},
			"pMessage": {
				"type": "string",
				"defaultValue": "Test Message"
			},
			"pDeleteFiles": {
				"type": "bool",
				"defaultValue": false
			},
			"pSourceFolder": {
				"type": "string",
				"defaultValue": "benevity/source"
			},
			"pMailTo": {
				"type": "string",
				"defaultValue": "Snehal.Kadam@bitwiseglobal.com"
			},
			"pMailCc": {
				"type": "string"
			},
			"pMailFrom": {
				"type": "string",
				"defaultValue": "Snehal.Kadam@bitwiseglobal.com"
			}
		},
		"variables": {
			"vSubject": {
				"type": "String"
			}
		},
		"annotations": []
	}
}