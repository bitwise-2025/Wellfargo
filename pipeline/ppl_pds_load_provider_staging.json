dded 02/03/09 Amanda Dalton \t AND LOGICAL_DELETE_IND = 'N' \t group by PROV_ADDR_ID    ) MAX_PRI_ADDR    ON ( MAX_PRI_ADDR.PROV_ADDR_ID = PROA.PROV_ADDR_ID         AND MAX_PRI_ADDR.MAX_ADDR_DT = PROA.PROV_ADDR_BEGIN_DT         AND PROA.ADDRESS_TYPE_CD = 'PRI'        )"
