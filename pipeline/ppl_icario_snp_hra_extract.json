          "text" : "DECLARE @In_Created_Date VARCHAR(8)\nDECLARE @In_Created_Time VARCHAR(4)\nDECLARE @In_Created_Seconds VARCHAR(2)\nDECLARE @In_Created_MilliSeconds VARCHAR(3)\nDECLARE @IN_PROCESSNAME VARCHAR(255)\n\n\nSET @In_Created_Date = CONVERT(CHAR(8),GETDATE(),112)\n\nSET @In_Created_Time = RIGHT('00' + CONVERT(NVARCHAR(2), DATEPART(HOUR, GETDATE())), 2) + RIGHT('00' + CONVERT(NVARCHAR(2), DATEPART(MINUTE, GETDATE())), 2)\n\nSET @In_Created_Seconds = RIGHT('00' + CONVERT(NVARCHAR(2), DATEPART(SECOND, GETDATE())), 2)\n\nSET @In_Created_MilliSeconds = RIGHT('00' + CONVERT(NVARCHAR(3), DATEPART(MILLISECOND, GETDATE())), 3)\n\nSET @IN_PROCESSNAME = @0 \n\nIF EXISTS (Select 'X'\n   FROM [EXTRACT].[Icario_SNP_HRA_Process_Log] (nolock)\n   WHERE STATUS = 'COMPLETED SUCCESSFULLY'\n   AND  PROCESSNAME = @IN_PROCESSNAME\n    )\n\nBEGIN\n Select MAX(ACTUALRUNDATE) AS LASTREPORTRUNDATE, DATEADD(DAY,1,MAX(ACTUALRUNDATE)) AS ACTUALRUNDATE,CONCAT('Elevance_',@IN_PROCESSNAME,'_11688-25-01_',@In_Created_Date,'_',@In_Created_Time,@In_Created_Seconds,'.txt') AS FILENAME\n FROM [EXTRACT].[Icario_SNP_HRA_Process_Log] (nolock)\n WHERE STATUS = 'COMPLETED SUCCESSFULLY'\n AND  PROCESSNAME = @IN_PROCESSNAME\nEND\nELSE \nBEGIN\n SELECT CAST(NULL AS DATETIME) AS LASTREPORTRUNDATE,CAST(GETDATE() AS DATETIME) AS ACTUALRUNDATE,CONCAT('Elevance_',@IN_PROCESSNAME,'_11688-25-01_',@In_Created_Date,'_',@In_Created_Time,@In_Created_Seconds,'.txt') AS FILENAME\nEND\n"
