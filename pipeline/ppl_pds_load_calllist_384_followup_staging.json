          "sqlReaderQuery" : "SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED  DECLARE @LAST_LOAD_DTM DATETIME = ? DECLARE @LAST_LOAD_DATE_INT INT DECLARE @LAST_LOAD_TIME_INT INT  SELECT @LAST_LOAD_DATE_INT = DATE_KEY FROM CAREADVANCE_DM.APP_CAEDM.DW_DIM_DATE WHERE DATE = CONVERT(DATETIME,CONVERT(DATE,@LAST_LOAD_DTM)) SELECT @LAST_LOAD_TIME_INT = TIME_KEY FROM CAREADVANCE_DM.APP_CAEDM.DW_DIM_TIME WHERE TIME = CONVERT(DATETIME,CONVERT(TIME,@LAST_LOAD_DTM))  DECLARE @TMP_FORM_CONCEPT_CONFIG TABLE (FORM_CONCEPT_CONFIG_KEY INT) INSERT INTO @TMP_FORM_CONCEPT_CONFIG (FORM_CONCEPT_CONFIG_KEY) SELECT DFCC.FORM_CONCEPT_CONFIG_KEY FROM [APP_CAEDM].DW_DIM_FORM_CONCEPT_CONFIG DFCC   INNER JOIN [APP_CAEDM].DW_DIM_CONCEPT DC ON DFCC.CONCEPT_KEY = DC.CONCEPT_KEY \tAND DC.CONCEPT_ID = 561308  select DM.SUBSCRIBER_ID + '00' AS MEMBERNUMBER,FMFC.Answer   FROM [APP_CAEDM].[DW_DIM_FORM] DF \tINNER JOIN [APP_CAEDM].[DW_FACT_MEMBER_FORM] FMF on FMF.FORM_KEY = DF.FORM_KEY \t\tAND DF.FORM_ID = '500975' \t\tAND ( \t\t\tFMF.CREATE_DATE>@LAST_LOAD_DATE_INT  \t\t\tOR (FMF.CREATE_DATE=@LAST_LOAD_DATE_INT AND FMF.CREATE_TIME>@LAST_LOAD_TIME_INT) \t\t) \tINNER JOIN [APP_CAEDM].[DW_FACT_MEMBER_FORM_CONCEPT] FMFC on FMF.MEMBER_FORM_KEY = FMFC.MEMBER_FORM_KEY \t\tAND FMFC.FORM_CONCEPT_CONFIG_KEY IN (SELECT FORM_CONCEPT_CONFIG_KEY FROM @TMP_FORM_CONCEPT_CONFIG) \tINNER JOIN [APP_CAEDM].DW_DIM_MEMBER DM on FMF.MEME_CK = DM.MEME_CK"
