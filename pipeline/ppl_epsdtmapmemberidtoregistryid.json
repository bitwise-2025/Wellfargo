tryId' AND DATAFLOW_NAME = '_COPYDATAForeach_Loop_Container134__Create_Archive') AS _COPYDATAForeach_Loop_Container134__Create_Archive_sink_SchemaName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = '_COPYDATAForeach_Loop_Container134__Create_Archive_sink_TableName' AND PIPELINE_NAME = 'EPSDTMapMemberIdToRegistryId' AND DATAFLOW_NAME = '_COPYDATAForeach_Loop_Container134__Create_Archive') AS _COPYDATAForeach_Loop_Container134__Create_Archive_sink_TableName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = '_COPYDATAForeach_Loop_Container134__Rename_Archive_source_SchemaName' AND PIPELINE_NAME = 'EPSDTMapMemberIdToRegistryId' AND DATAFLOW_NAME = '_COPYDATAForeach_Loop_Container134__Rename_Archive') AS _COPYDATAForeach_Loop_Container134__Rename_Archive_source_SchemaName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = '_COPYDATAForeach_Loop_Container134__Rename_Archive_source_TableName' AND PIPELINE_NAME = 'EPSDTMapMemberIdToRegistryId' AND DATAFLOW_NAME = '_COPYDATAForeach_Loop_Container134__Rename_Archive') AS _COPYDATAForeach_Loop_Container134__Rename_Archive_source_TableName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = '_COPYDATAForeach_Loop_Container134__Rename_Archive_sink_SchemaName' AND PIPELINE_NAME = 'EPSDTMapMemberIdToRegistryId' AND DATAFLOW_NAME = '_COPYDATAForeach_Loop_Container134__Rename_Archive') AS _COPYDATAForeach_Loop_Container134__Rename_Archive_sink_SchemaName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = '_COPYDATAForeach_Loop_Container134__Rename_Archive_sink_TableName' AND PIPELINE_NAME = 'EPSDTMapMemberIdToRegistryId' AND DATAFLOW_NAME = '_COPYDATAForeach_Loop_Container134__Rename_Archive') AS _COPYDATAForeach_Loop_Container134__Rename_Archive_sink_TableName,\n(SELECT PARAMETER_VALUE FROM AZ_PARAMETERS WHERE PARAMETER_NAME = 'OLE_DB_Destination_Data_Flow_Task137__source_SchemaName' AND PIPELINE_NAME = 'EPSDTMapMemberIdToRegistryId' AND DATAFL