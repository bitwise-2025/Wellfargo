      "typeProperties" : {
        "scripts" : [ {
          "type" : "Query",
          "text" : "DECLARE @JobId INT\nDECLARE @JobCode VARCHAR(8000)\nDECLARE @EnvironName VARCHAR(8000)\nDECLARE @FolderPath VARCHAR(8000)\nDECLARE @ArchiveFolderPath VARCHAR(8000)\nDECLARE @TidalJobNumber VARCHAR(8000)\nDECLARE @TempTidalJobNumber VARCHAR(8000)\nDECLARE @ProcessMonths VARCHAR(8000)\nDECLARE @ProcessJob VARCHAR(1)\n\nSET @JobCode = @0\nSET @TidalJobNumber = @1\n\nSET @EnvironName = (SELECT Top 1 Value FROM EPSDTAppConfig WHERE ConfigKey = 'Environment')\n\n--if dev and running from visualstudio (instead of tidal), then put D in front\nIF @EnvironName = 'Dev' AND @TidalJobNumber LIKE 'D%'\nBEGIN\n SET @TempTidalJobNumber = (SELECT MAX(TidalJobNumber) FROM EPSDTJobFile WHERE TidalJobNumber LIKE 'D%')\n SET @TidalJobNumber = 'D' + LTRIM(RTRIM(STR(ISNULL(CONVERT(INT, REPLACE(@TempTidalJobNumber, 'D', '')) + 1, 1))))\nEND\n\nSET @JobId = (SELECT Top 1 JobId FROM EPSDTJob WHERE JobCode = @JobCode)\nSET @FolderPath = (SELECT Top 1 Value FROM EPSDTJobConfig WHERE JobId = @JobId AND ConfigKey = 'FullFolderPath' and EnvironName = @EnvironName)\nSET @ArchiveFolderPath = (SELECT top 1 Value FROM EPSDTJobConfig WHERE JobId = @JobId AND ConfigKey = 'ArchiveFullFolderPath' and EnvironName = @EnvironName)\n\nSET @ProcessMonths = (SELECT top 1 Value FROM EPSDTJobConfig WHERE JobId = @JobId AND ConfigKey = 'ProcessMonths' and EnvironName = @EnvironName)\n--if this state job is suppose to run this month, then let it\nIF EXISTS (SELECT * FROM fnConvertListToStringTable(@ProcessMonths ,',') WHERE Item = MONTH(GETDATE()))\n SET @ProcessJob = '1' \nELSE\n SET @ProcessJob = '0' \n\n\nSELECT TOP 1\nJobId = @JobId,\nFolderPath = @FolderPath,\nFilePattern = (SELECT top 1 Value FROM EPSDTJobConfig WHERE JobId = @JobId AND ConfigKey = 'FilePattern' and EnvironName = @EnvironName),\nDelimiter = (SELECT top 1 Value FROM EPSDTJobConfig WHERE JobId = @JobId AND ConfigKey = 'Delimiter' and EnvironName = @EnvironName),\nArchiveFolderPath = @ArchiveFolderPath,\nTidalJobNumber = @TidalJobNumber,\nProcessJob = @ProcessJob,\nSuccessEmailTo = (select top 1 Value from EPSDTJobConfig where ConfigKey = 'EmailJobCompletionTo' and JobID = @JobId and EnvironName = @EnvironName),\nFailureEmailTo = (select top 1 Value from EPSDTJobConfig where ConfigKey = 'EmailJobErrorTo' and JobID = @JobId and EnvironName = @EnvironName),\nSucessEmailSubject = (select top 1 Value from EPSDTJobConfig where ConfigKey = 'EmailJobCompletionSubject' and JobID = @JobId and EnvironName = @EnvironName),\nFailureEmailSubject = (select top 1 Value from EPSDTJobConfig where ConfigKey = 'EmailJobErrorSubject' and JobID = @JobId and EnvironName = @EnvironName),\nSuccessEmailBody = (select top 1 Value from EPSDTJobConfig where ConfigKey = 'EmailJobCompletionBody' and JobID = @JobId and EnvironName = @EnvironName),\nFailureEmailBody = (select top 1 Value from EPSDTJobConfig where ConfigKey = 'EmailJobErrorBody' and JobID = @JobId and EnvironName = @EnvironName)\n\n \n\n\n"
        } ],
