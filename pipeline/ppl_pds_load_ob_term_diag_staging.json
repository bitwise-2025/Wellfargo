      },
      "SQLStatement" : {
        "type" : "string",
        "defaultValue" : "'SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED\\n\\nSELECT ml.SRC_SYS_MEMBER_NBR, dd.CLM_LINE_DIAG_CD, dd.CLM_LINE_DIAG_CODESET_CD, cl.CLM_STATEMENT_BEGIN_DT, PL.SRC_SYS_PROVIDER_NBR\\nFROM  dbo.CLAIM AS cl INNER JOIN\\n    dbo.MEMBER_LOOKUP AS ml ON ml.MEMBER_ID = cl.MEMBER_ID AND cl.CLM_STATEMENT_BEGIN_DT > '12/5/2016' AND cl.LOGICAL_DELETE_IND = 'N' INNER JOIN\\n    dbo.CLAIM_LINE_DIAGNOSIS AS dd ON dd.CLAIM_ID = cl.CLAIM_ID \\n\tAND ((dd.CLM_LINE_DIAG_CODESET_CD = 'ICD10' AND dd.CLM_LINE_DIAG_CD IN('O001','O002','O008','O009','O01','O010','O011','O019','O02','O020','O021','O028','O0281','O0289','O029','O030','O031','O032','O033','O0330','O0331','O0332','O0333','O0334','O0335','O0336','O0337','O0338','O0339','O034','O03','O035','O036','O037','O038','O0380','O0381','O0382','O0383','O0384','O0385','O0386','O0387','O0388','O0389','O039','O04','O045','O046','O047','O048','O0480','O0481','O0482','O0483','O0484','O0485','O0486','O0487','O0488','O0489','O08','O080','O081','O082','O083','O084','O085','O086','O087','O088','O0881','O0882','O0883','O0889','O089','Z332','Z371','Z374','Z377')) OR (dd.CLM_LINE_DIAG_CODESET_CD = 'ICD9' AND dd.CLM_LINE_DIAG_CD IN()))\\n AND cl.MEMBER_ID IS NOT NULL AND dd.LOGICAL_DELETE_IND = 'N' INNER JOIN \\n\tdbo.CLAIM_LINE CLML ON dd.CLAIM_ID = CLML.CLAIM_ID AND dd.CLM_LINE_SEQ_NBR = CLML.CLM_LINE_SEQ_NBR INNER JOIN \\n\tdbo.PROVIDER_LOOKUP PL ON CLML.CLM_LINE_SVC_PROV_ID = PL.PROVIDER_ID\\nGROUP BY ml.SRC_SYS_MEMBER_NBR, dd.CLM_LINE_DIAG_CD, dd.CLM_LINE_DIAG_CODESET_CD, cl.CLM_STATEMENT_BEGIN_DT, PL.SRC_SYS_PROVIDER_NBR'"
      }
