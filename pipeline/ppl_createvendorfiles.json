      "onInactiveMarkAs" : null,
      "linkedServiceName" : {
        "referenceName" : "AzureSqlDatabase1",
        "type" : "LinkedServiceReference"
      },
      "typeProperties" : {
        "scripts" : [ {
          "type" : "Query",
          "text" : "DECLARE @UpdateDate datetime\nSET @UpdateDate = @StartDateTime\n\nDECLARE @FileRecipients VARCHAR(1000)\nSET @FileRecipients = @VendorEmailRecipients\n\nDECLARE @NoFileRecipients VARCHAR(1000)\nSET @NoFileRecipients = @NoFileEmailRecipients\n\nDECLARE @TotalCount bigint\nSELECT @TotalCount = ISNULL(sum(RecordsApproved),0)\nFROM dbo.RequestSummary RS\nWHERE RS.UpdateDate >= @UpdateDate\n\nDECLARE @EmailRecipients VARCHAR(1000)\n\nDECLARE @tableHTML NVARCHAR(MAX) ;\n\nIF @TotalCount = 0\n   BEGIN\n    SET @tableHTML =\n   \t N'<html><body><font face=\"Tahoma\">' +\n    \tN'<h5>There were no vendor files created today.</h5>' +\n    \tN'Please verify with the business that this is accurate, and send an empty file to Eliza.' +\n\t'</font></body></font></html>'\n\t\n    SET @EmailRecipients = @NoFileRecipients \n   END\nELSE\n   BEGIN\n    SET @tableHTML =\n    N'<html><body><font face=\"Tahoma\"><h4>Total Counts By Request</h4>' +\n    N'<table border=\"1\" width=\"100%\">' +\n    N'<font face=\"Tahoma\"><tr bgcolor=\"#99CCFF\"><td>RequestID</td><td>VendorName</td><td>ApplicationName</td><td>Group ID</td><td>Records Created</td><td>Records Approved</td></tr>' +\n            CAST((\n        SELECT\n                    td = R.RequestID, '',\n                    td = R.Vendor, '',\n                    td = R.ApplicationName, '',\n                    td = CASE WHEN R.GroupID IS NULL THEN 'XX' ELSE R.GroupID END, '',\n                    td = RS.RecordsCreated, '',\n                    td = RS.RecordsApproved, ''\n            FROM dbo.Requests R\n\t\t\tINNER JOIN dbo.RequestSummary RS\n\t\t\t\tON R.RequestID = RS.RequestID\n\t\t\tWHERE RS.UpdateDate >= @UpdateDate  AND RS.RecordsApproved <> 0\n\tORDER BY R.RequestID\n                    FOR XML PATH('tr'), TYPE) AS NVARCHAR(MAX)) + N'</table>' +\n\tN'<h4>Total Record Count: ' + CONVERT(VARCHAR(10),@TotalCount) +  '</font></body></font></html>'\n\n    SET @EmailRecipients = @FileRecipients \n    END\n\nEXEC msdb.dbo.sp_send_dbmail \n\t@recipients=@EmailRecipients \n\t, @subject = 'Daily Vendor Files Created - Approved'\n\t, @body = @tableHTML\t\n\t, @body_format = 'HTML'\n\n\t"
        } ],
        "scriptBlockExecutionTimeout" : null
      }
