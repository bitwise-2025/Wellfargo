{
	"name": "PL_Simple_OnAnyFailure",
	"properties": {
		"activities": [
			{
				"name": "Load data",
				"type": "Filter",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.pTestData",
						"type": "Expression"
					},
					"condition": {
						"value": "@greater(int(item().Amount), 0)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get Rows Loaded",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Load data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Load data').output.Value",
						"type": "Expression"
					},
					"condition": {
						"value": "@greater(int(item().Qty), 0)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Send failure mail",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Get Rows Loaded",
						"dependencyConditions": [
							"Failed",
							"Skipped"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 2,
					"retryIntervalInSeconds": 30
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "https://prod-10.centralindia.logic.azure.com:443/workflows/50eacae33dcc433a9c058d527e0e4c2e/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=wJfeRx2-cuKaDO9kWF3J1yY0UslGSEFHFI_3r0krlCk",
						"type": "Expression"
					},
					"body": {
						"value": "{\"to\":\"@{pipeline().parameters.pMailTo}\",\"cc\":\"@{pipeline().parameters.pMailCc}\",\"from\":\"@{pipeline().parameters.pMailFrom}\",\"importance\":\"High\",\"subject\":\"ADF pipeline FAILED: @{pipeline().Pipeline}\",\"bodyB64\":\"@{base64(concat('Run ID: ', pipeline().RunId, decodeUriComponent('%0A'), 'Start time (UTC): ', pipeline().TriggerTime, decodeUriComponent('%0A'), 'Error: ', coalesce(activity('Load data')?.error?.message, ''), coalesce(activity('Get Rows Loaded')?.error?.message, '')))}\"}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Re-raise error",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Send failure mail",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@concat('Pipeline failed: ', coalesce(activity('Load data')?.error?.message, ''), coalesce(activity('Get Rows Loaded')?.error?.message, ''))",
						"type": "Expression"
					},
					"errorCode": "500"
				}
			}
		],
		"parameters": {
			"pTestData": {
				"type": "array",
				"defaultValue": [
					{
						"TradeId": "T1",
						"Amount": "100",
						"Qty": "5"
					},
					{
						"TradeId": "T2",
						"Amount": "250",
						"Qty": "3"
					},
					{
						"TradeId": "T3",
						"Amount": "0",
						"Qty": "1"
					}
				]
			},
			"pMailTo": {
				"type": "string",
				"defaultValue": "Snehal.Kadam@bitwiseglobal.com"
			},
			"pMailCc": {
				"type": "string"
			},
			"pMailFrom": {
				"type": "string",
				"defaultValue": "Snehal.Kadam@bitwiseglobal.com"
			}
		},
		"annotations": []
	}
}