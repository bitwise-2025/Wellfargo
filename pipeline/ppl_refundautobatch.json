      "gv_RefundQuery" : {
        "type" : "string",
        "defaultValue" : "'SELECT DISTINCT \\n            'N' AS PDBL_ID,\\n            ' ' AS RECEIPT_REASON,\\n            ' ' AS PAYMENT_METHOD,\\n            SBSB.SBSB_ID, \\n            ' ' AS BGBG_ID,\\n            GRGR.GRGR_ID,\\n            BLEI.BLEI_NET_ALLOC_SUSP,\\n            SBSB.SBSB_RECD_DT,\\n            NULL AS RECEIVED_DATE\\n  FROM FACETS.CMC_SBSB_SUBSC  SBSB\\n       JOIN FACETS.CMC_BLEI_ENTY_INFO BLEI\\n           ON     SBSB_CK = BLEI.BLEI_BILL_LEVEL_CK\\n              AND BLEI.BLEI_BILL_LEVEL = 'I'\\n              AND BLEI_NET_ALLOC_SUSP > 0\\n       JOIN FACETS.CMC_GRGR_GROUP GRGR ON SBSB.GRGR_CK = GRGR.GRGR_CK\\n       LEFT JOIN FACETS.CMC_MEME_MEMBER MEME ON MEME.SBSB_CK = SBSB.SBSB_CK\\n       JOIN FACETS.AU_CMC_SBSB_SUBSC AU\\n           ON     SBSB.SBSB_ID = AU.SBSB_ID\\n              AND AU.SBSB_RETIRE_DT = SBSB.SBSB_RETIRE_DT\\n              AND AU.HIST_IMAGE_CD = 'A'\\n              AND EXISTS\\n                      (SELECT *\\n                         FROM FACETS.AU_CMC_SBSB_SUBSC S2\\n                        WHERE     AU.SBSB_ID = S2.SBSB_ID\\n                              AND AU.TXN1_ROW_ID = S2.TXN1_ROW_ID\\n                              AND AU.HIST_IMAGE_CD != S2.HIST_IMAGE_CD\\n                              AND AU.SBSB_RETIRE_DT != S2.SBSB_RETIRE_DT\\n            )  \\nWHERE SBSB.SBSB_RETIRE_DT != TO_DATE('1/1/1753', 'MM/DD/YYYY')\\nAND (GRGR.GRGR_ID LIKE '%MCRWP0' OR GRGR.GRGR_ID LIKE '%MCR000') \\nAND TO_TIMESTAMP('05/12/2022 11:59:59 PM' ,'MM/DD/YYYY HH:MI:SS PM')>=CAST(TRUNC(AU.HIST_CREATE_DTM) AS DATE)+4 \\nAND NOT EXISTS (SELECT * FROM FACETS.CMC_RCPT_RECEIPTS RCPT\\n                WHERE RCPT_INPUT_SBSB_ID =SBSB.SBSB_ID\\n                AND (RCPT_CREATE_DTM >= TO_TIMESTAMP('05/12/2022 11:59:59 PM' ,'MM/DD/YYYY HH:MI:SS PM')-15)\\n  AND RCPT_RCPT_CD='P')   \\nAND NOT EXISTS (SELECT 1 FROM FACETS.CMC_RCPT_RECEIPTS RCPT\\nWHERE RCPT_INPUT_SBSB_ID =SBSB.SBSB_ID AND RCPT.RCPT_RCPT_CD IN ('W') \\nAND RCPT_CREATE_DTM = (SELECT MAX (RCPT_CREATE_DTM) FROM  FACETS.CMC_RCPT_RECEIPTS RCPT1    \\nWHERE RCPT1.RCPT_INPUT_SBSB_ID =RCPT.RCPT_INPUT_SBSB_ID))\\nUNION\\nSELECT \\n 'N' AS PDBL_ID,\\n            ' ' AS RECEIPT_REASON,\\n            ' ' AS PAYMENT_METHOD,\\n            SBSB.SBSB_ID, \\n            ' ' AS BGBG_ID,\\n            GRGR.GRGR_ID,\\n            BLEI.BLEI_NET_ALLOC_SUSP,\\n            SBSB.SBSB_RECD_DT,\\n            NULL AS RECEIVED_DATE\\nFROM CMC_SBSB_SUBSC SBSB  \\nJOIN CMC_MEME_MEMBER MEME ON SBSB.SBSB_CK = MEME.SBSB_CK AND MEME.GRGR_CK = SBSB.GRGR_CK \\nJOIN CMC_GRGR_GROUP GRGR ON MEME.GRGR_CK = GRGR.GRGR_CK AND GRGR.GRGR_ID LIKE '%PDP%'\\nJOIN FACETS.CMC_MEMD_MECR_DETL MEMD ON MEME.MEME_CK = MEMD.MEME_CK AND MEME.GRGR_CK = MEMD.GRGR_CK AND MEMD_EVENT_CD = 'DETH'\\nJOIN FACETS.CMC_BLEI_ENTY_INFO BLEI ON SBSB.SBSB_CK = BLEI.BLEI_BILL_LEVEL_CK AND BLEI.BLEI_BILL_LEVEL = 'I' AND BLEI_NET_ALLOC_SUSP > 0\\nJOIN (SELECT RCPT_INPUT_SBSB_ID, MAX(RCPT_CREATE_DTM) RCPT_CREATE_DTM \\n                            FROM CMC_RCPT_RECEIPTS WHERE RCPT_RCPT_CD = 'P' AND RCPT_STS IN ('01','91') \\n                            GROUP BY RCPT_INPUT_SBSB_ID) RCPT  ON SBSB.SBSB_ID = RCPT.RCPT_INPUT_SBSB_ID\\nWHERE TO_TIMESTAMP('05/12/2022 11:59:59 PM' ,'MM/DD/YYYY HH:MI:SS PM') >= CASE WHEN (TRUNC(RCPT_CREATE_DTM) +15) > (MEMD_HCFA_EFF_DT+4) THEN (TRUNC(RCPT_CREATE_DTM) +15) ELSE (MEMD_HCFA_EFF_DT+4) END\\nUNION \\nSELECT DISTINCT \\n            'N' AS PDBL_ID,\\n            'ROTH' AS RECEIPT_REASON,\\n            ' ' AS PAYMENT_METHOD,\\n            SBSB.SBSB_ID, \\n            ' ' AS BGBG_ID,\\n            GRGR.GRGR_ID,\\n            RCPT.RCPT_AMT,\\n            SBSB.SBSB_RECD_DT,\\n            NULL AS RECEIVED_DATE\\nFROM FACETS.CMC_SBSB_SUBSC SBSB\\n       JOIN FACETS.CMC_GRGR_GROUP GRGR\\n          ON SBSB.GRGR_CK = GRGR.GRGR_CK AND (GRGR.GRGR_ID LIKE '%EGR%' OR GRGR.GRGR_ID LIKE '%GRS%')\\n      JOIN FACETS.CMC_RCPT_RECEIPTS RCPT \\n          ON RCPT.RCPT_INPUT_SBSB_ID = SBSB.SBSB_ID \\n          AND RCPT.RCPT_INPUT_GRGR_ID = GRGR.GRGR_ID\\n             AND RCPT.RCPT_MCTR_RSN = 'PGRS'\\n             AND RCPT.RCPT_STS =91\\nWHERE RCPT.RCPT_CREATE_DTM > TO_TIMESTAMP('05/12/2022 11:59:59 PM' ,'YYYY-MM-DD HH:MI:SS AM') \\n  AND RCPT.RCPT_CREATE_DTM <= TO_TIMESTAMP('2015-01-15 09:27:47 AM' ,'YYYY-MM-DD HH:MI:SS AM') \\nUNION \\nSELECT  DISTINCT \\n        RECEIPT_CODE,\\n        RECEIPT_REASON,\\n        PAYMENT_METHOD,\\n        SUBSCRIBER_ID,\\n        ' ' AS BGBG_ID,\\n        GROUP_ID AS GRGR_ID,\\n        RFD_AMOUNT,\\n        CHECK_NUMBER,\\n        RECEIVED_DATE \\n    FROM AGP.LISR_DUMMYPAYMENTS_REFUNDS\\nUNION \\nSELECT DISTINCT\\n        'F' AS RECEIPT_CODE,\\n        'RLIS' AS RECEIPT_REASON,\\n        'B' AS PAYMENT_METHOD,\\n        ' ' AS SUBSCRIBER_ID,\\n        BGBG.BGBG_ID,\\n        ' ' AS GRGR_ID,\\n        ABS(SUM(INSB.BLSB_PREM_SB)) AS RFD_AMOUNT,\\n        MAX(BLBL.BLBL_DUE_DT) AS CHECK_NUMBER,\\n        NULL AS RECEIVED_DATE \\n    FROM FACETS.CMC_BGBG_BIL_GROUP BGBG\\n         JOIN FACETS.CMC_BLEI_ENTY_INFO BLEI\\n          ON BGBG.BGBG_CK = BLEI.BLEI_BILL_LEVEL_CK and BGBG.bgbg_id = 'GRS00119'\\n             AND BLEI.BLEI_BILL_LEVEL = 'B'\\n        JOIN FACETS.CMC_BLBL_BILL_SUMM BLBL\\n           ON BLEI.BLEI_CK = BLBL.BLEI_CK\\n              AND BLBL.BLBL_SPCL_BL_IND <> 'C'\\n        JOIN FACETS.CMC_BLIV_INVOICE BLIV\\n           ON BLIV.BLEI_CK = BLEI.BLEI_CK \\n              AND BLIV.BLIV_CREATE_DTM BETWEEN  TO_TIMESTAMP('9999-12-31 12:00:00 AM' ,'YYYY-MM-DD  HH:MI:SS AM')  AND TO_TIMESTAMP('05/12/2022 11:59:59 PM' ,'MM/DD/YYYY HH:MI:SS PM')\\n              AND BLIV.BLBL_DUE_DT = BLBL.BLBL_DUE_DT\\n        JOIN (SELECT BLEI_CK, BLBL_DUE_DT, MAX(BLIV_CREATE_DTM) BLIV_CREATE_DTM\\n                 FROM FACETS.CMC_BLIV_INVOICE\\n                 GROUP BY BLEI_CK, BLBL_DUE_DT\\n                 ) MAXBLIV\\n                 ON BLIV.BLEI_CK = MAXBLIV.BLEI_CK\\n                 AND BLIV.BLIV_CREATE_DTM = MAXBLIV.BLIV_CREATE_DTM\\n                 AND BLIV.BLBL_DUE_DT = MAXBLIV.BLBL_DUE_DT\\n        JOIN FACETS.CDS_INSB_SB_DETAIL INSB\\n           ON INSB.BLIV_ID = BLIV.BLIV_ID\\n              AND INSB.PDBL_ID = 'LIS'\\n              AND INSB.BLSB_PREM_SB < 0\\n              GROUP BY \\n              BGBG.BGBG_ID'"
      },
