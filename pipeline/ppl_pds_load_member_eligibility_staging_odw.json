          "sqlReaderQuery" : "SELECT \tMEME.MEME_CK AS MEMBER_ID \t,MEPE.MEPE_EFF_DT AS MBR_ELIGIBLE_BEGIN_DT \t, SBSB.SBSB_ID + '00' AS SRC_SYS_MEMBER_NBR \t, 'FAC' AS SRC_SYS_CD \t, 'N' AS LOGICAL_DELETE_IND \t, MEPE.MEPE_TERM_DT AS MBR_ELIGIBLE_END_DT \t, NULL AS MBR_PLAN_CD \t, NULL AS MBR_MARKET_CD \t, NULL AS MBR_PRODUCT_CD \t, NULL AS MBR_SUB_PRODUCT_CD \t, MEPE.CSPI_ID AS MBR_MCAID_POP_CATGRY_CD \t, MEPE.SGSG_CK AS MBR_MCAID_COUNTY_CD \t, MEPE.MEPE_CREATE_DTM AS CREATE_DTTM \t, 'ODW LOAD' AS CREATE_USER_ID \t, MEPE.LAST_MODIFIED_DTM AS UPDATE_DTTM \t, 'ODW LOAD' AS UPDATE_USER_ID \t,MEPE.MEME_CK \t,MEPE.GRGR_CK \t,MEPE.CSCS_ID \t,GRGR.GRGR_ID  FROM  \tODW.DW.FAC_CMC_MEPE_PRCS_ELIG MEPE \t\tINNER JOIN ODW.DW.FAC_CMC_MEME_MEMBER MEME ON MEPE.MEME_CK = MEME.MEME_CK \t\t\tAND MEPE.MEPE_ELIG_IND = 'Y' \t\t\tAND MEPE.GRGR_CK = MEME.GRGR_CK \t\tINNER JOIN ODW.DW.FAC_CMC_SBSB_SUBSC SBSB ON MEME.SBSB_CK = SBSB.SBSB_CK \t\t\tAND MEME.GRGR_CK = SBSB.GRGR_CK \t\tINNER JOIN ODW.DW.FAC_CMC_GRGR_GROUP GRGR ON SBSB.GRGR_CK = GRGR.GRGR_CK"
