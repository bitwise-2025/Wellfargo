      },
      "Fact_Query" : {
        "type" : "string",
        "defaultValue" : "WITH myquery (dw_agg_key,iodatetime,rowvers)\\n     AS (SELECT dw_agg_key,\\n                        convert(datetime,( CONVERT(VARCHAR(10), iodate, 120) + ' ' + CONVERT(VARCHAR, iotime, 108) )) AS iodatetime,\\n                Row_number() OVER(PARTITION BY dw_agg_key ORDER BY (CONVERT(VARCHAR(10),iodate, 120) + ' ' + CONVERT(VARCHAR, iotime, 108)) ASC) rowvers\\n         FROM   [dbo].[FACT]\\n         WHERE  DW_RUN_KEY = 100\\n                        AND validentryflag = 0)                  \\nselect DW_AGG_KEY,\\nCONVERT(VARCHAR(8), DATEADD(SECOND, SUM(CASE WHEN ISDATE(TimeDiff) = 0 THEN NULL ELSE DATEDIFF(SECOND, '00:00:00', TimeDiff) END), '19000101'), 8) NetTime\\nfrom (select odd_entry.dw_agg_key,even_exit.iodatetime - odd_entry.iodatetime TimeDiff\\nfrom myquery odd_entry\\ninner join myquery even_exit\\non  odd_entry.rowvers % 2 = 1\\nand even_exit.rowvers % 2 = 0\\nand odd_entry.dw_agg_key = even_exit.dw_agg_key\\nand odd_entry.rowvers + 1 = even_exit.rowvers) InnerTable\\ngroup by dw_agg_key"
      },
      "Fact_TotalTime" : {
        "type" : "string",
        "defaultValue" : "WITH myquery (dw_agg_key,iodatetime,rowvers)\\n     AS (SELECT dw_agg_key,\\n                        convert(datetime,( CONVERT(VARCHAR(10), iodate, 120) + ' ' + CONVERT(VARCHAR, iotime, 108) )) AS iodatetime,\\n                Row_number() OVER(PARTITION BY dw_agg_key ORDER BY (CONVERT(VARCHAR(10),iodate, 120) + ' ' + CONVERT(VARCHAR, iotime, 108)) ASC) rowvers\\n         FROM   [Metadata_BI].[dbo].[FACT]\\n         WHERE  DW_RUN_KEY = 100\t\t\t\t\t\t\\n                        AND validentryflag = 0) \\nselect odd_entry.dw_agg_key,\\nCASE\\n       When Datediff(d,max(convert(datetime,CONVERT(VARCHAR(10), even_exit.iodatetime, 120))), min(convert(datetime,( CONVERT(VARCHAR(10), odd_entry.iodatetime, 120) ))))= -1\\n       Then\\n       convert(varchar(10),dateadd(hh,12,max(even_exit.iodatetime)),108)           \\n       Else\\n            convert(varchar(10),(max(even_exit.iodatetime) - min(odd_entry.iodatetime)),108)\\nEnd  \\nTotal_OOO \\nfrom myquery odd_entry\\ninner join myquery even_exit\\non  odd_entry.rowvers % 2 = 1\\nand even_exit.rowvers % 2 = 0\\nand odd_entry.dw_agg_key = even_exit.dw_agg_key\\nand odd_entry.rowvers + 1 = even_exit.rowvers\\ngroup by odd_entry.dw_agg_key"
