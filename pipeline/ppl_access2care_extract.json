          "text" : " DECLARE @V_EXECUTION_TIME DATETIME = CONVERT(VARCHAR(19), GETDATE(), 120)\n DECLARE @STARTDATE DATETIME\n DECLARE @ENDDATE DATETIME \n DECLARE @HISTORY_ID INT\n\n SET @STARTDATE  = @0\n SET @ENDDATE = @1\n\n\n IF @STARTDATE = '1/1/1901' OR @STARTDATE IS NULL OR  ISDATE(@STARTDATE) = 0 \n    SELECT @STARTDATE = Dynamic_Extract_Config_DeltaDate FROM [EXTRACT].[Dynamic_Extract_Config]  WHERE Dynamic_Extract_Config_LookupCode IN ('ACCESS2CARE_REPORT')\n\n ELSE\n  SELECT  @STARTDATE = @STARTDATE  \n\n IF @ENDDATE = '1/1/1901' OR @ENDDATE IS NULL OR  ISDATE(@ENDDATE) = 0 \n  SET @ENDDATE = @V_EXECUTION_TIME\n ELSE\n  SET @ENDDATE = @ENDDATE \n\n\nINSERT INTO [EXTRACT].[Dynamic_Extract_history]\n(Dynamic_Extract_Config_ID,Dynamic_Extract_Start_Date,Dynamic_Extract_End_Date,Dynamic_Extract_History_Execution_Time)\nSELECT Dynamic_Extract_Config_ID, @STARTDATE,@ENDDATE, @V_EXECUTION_TIME FROM [EXTRACT].[Dynamic_Extract_Config] WHERE Dynamic_Extract_Config_LookupCode IN ('ACCESS2CARE_REPORT')\n\nSET @HISTORY_ID = @@IDENTITY\n\nSELECT @STARTDATE AS STARTDATE, @ENDDATE AS ENDDATE, @HISTORY_ID as History_Id\n\n\n"
