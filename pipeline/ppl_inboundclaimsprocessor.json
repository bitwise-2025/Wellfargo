          "typeProperties" : {
            "scripts" : [ {
              "type" : "Query",
              "text" : "--DECLARE @FULL_FILENAME VARCHAR(500) \n--DECLARE @FILE_NM VARCHAR(100) \nDECLARE @VENDOR_ID VARCHAR(6) \n\n--SET @FULL_FILENAME =@Vendor_ID \nSET @VENDOR_ID=? \n--SET @FILE_NM=Ltrim(Rtrim(Reverse(Substring(Reverse(@FULL_FILENAME), 0, Charindex('\\', Reverse(@FULL_FILENAME), 0)))))\n\nUPDATE A \nSET    BALANCED = 'Y' \nFROM   [CIFT].[ETLSourceInputFileLog] A \n       JOIN (SELECT A.SRC_FILE_ID, \n                    A.SOURCE_CNT, \n                    B.EDINET_CNT \n             FROM   (SELECT SRC_FILE_ID, \n                            Sum(FILE_CLM_CNT)                                       AS SOURCE_CNT\n                     FROM   [CIFT].[ETLSourceInputFileLog] ES JOIN [cift].[ETLSourceInputFileConfig] ESC \n      ON ESC.VENDOR_ID = ES.VENDOR_ID and ESC.ROUND = ES.ROUND\n                     WHERE  ES.VENDOR_ID = @VENDOR_ID \n      AND BALANCED = 'N' AND ESC.BALANCE_FLAG='Y' \n                     GROUP  BY SRC_FILE_ID) A \n                    JOIN (SELECT SRC_FILE_ID, \n                                 Sum(FILE_CLM_CNT)                                       AS EDINET_CNT\n                          FROM   [CIFT].[ETLEDINETINPUTFILELOG] \n                          WHERE  VENDOR_ID = @VENDOR_ID \n        --AND SRC_FILE_ID=(SELECT DISTINCT SRC_FILE_ID FROM [CIFT].[ETLEDINETINPUTFILELOG] WHERE INPUT_FILE_NM=@FILE_NM)\n                          GROUP  BY SRC_FILE_ID) B \n                      ON A.SRC_FILE_ID = B.SRC_FILE_ID \n                         AND A.SOURCE_CNT = B.EDINET_CNT) B \n         ON A.SRC_FILE_ID = B.SRC_FILE_ID \n            AND A.BALANCED = 'N' "
