      "typeProperties" : {
        "source" : {
          "type" : "AzureSqlsource",
          "sqlReaderQuery" : "query to get language from IR select distinct   p.SRC_SYS_MEMBER_NBR , ml.LANGUAGE_DESC , l.CREATE_DTTM , l.CREATE_USER_ID  from INTEGRATION_REPOSITORY.dbo.MEMBER_LANGUAGE l with (nolock)  inner join INTEGRATION_REPOSITORY.dbo.MEMBER_LOOKUP p with (nolock)   on p.MEMBER_ID = l.MEMBER_ID    and p.SRC_SYS_CD = l.SRC_SYS_CD inner join  (SELECT p2.SRC_SYS_MEMBER_NBR, MAX(l2.CREATE_DTTM)as M_DTTM               FROM INTEGRATION_REPOSITORY.dbo.MEMBER_LANGUAGE l2  with (nolock) \t\t\t inner join INTEGRATION_REPOSITORY.dbo.MEMBER_LOOKUP p2 with (nolock) \t\t\t  on p2.MEMBER_ID = l2.MEMBER_ID \t\t\t   and p2.SRC_SYS_CD = l2.SRC_SYS_CD Group by p2.SRC_SYS_MEMBER_NBR) MXL        on l.CREATE_DTTM=MXL.M_DTTM and p.SRC_SYS_MEMBER_NBR=MXL.SRC_SYS_MEMBER_NBR and l.LOGICAL_DELETE_IND = 'N' inner join INTEGRATION_REPOSITORY.dbo.MSTR_LANGUAGE ml with (nolock)   on ml.LANGUAGE_CD = l.MBR_LANGUAGE_CD"
        },
        "sink" : {
          "type" : "AzureSqlSink",
          "writeBehavior" : "insert",
          "sqlWriterUseTableLock" : false
        }
