          "sqlReaderQuery" : "SELECT DISTINCT IDCD.IDCD_ID,CASE WHEN IDCD.IDCD_TYPE = 'T' THEN 'ICD10' ELSE 'ICD9' END ,'DIAG' AS CodeType FROM PDS_OB_CODES OC INNER JOIN ODW.DW.FAC_CMC_IDCD_DIAG_CD IDCD ON OC.OB_CODES_CODE_VALUE = IDCD.IDCD_ID AND OC.OB_CODES_CODE_TYPE = 'DIAG' AND ((IDCD.IDCD_TYPE = 'T' AND OC.OB_CODES_CODESET_CD = 'ICD10') OR (IDCD.IDCD_TYPE IN ('I',' ') AND OC.OB_CODES_CODESET_CD = 'ICD9')) SELECT DISTINCT SBSB.SBSB_ID + '00' AS SRC_SYS_MEMBER_NBR, CLMD.IDCD_ID AS CLM_LINE_DIAG_CD, IDCD.CLM_LINE_DIAG_CODESET_CD, CLCL.CLCL_LOW_SVC_DT AS CLM_STATEMENT_BEGIN_DT, CLCL.PRPR_ID AS SRC_SYS_PROVIDER_NBR FROM @IDCD_IDS IDCD INNER JOIN ODW.DW.FAC_CMC_CLMD_DIAG CLMD ON CLMD.IDCD_ID = IDCD.IDCD_ID AND CLMD.LAST_MODIFIED_DTM > ? INNER JOIN ODW.DW.FAC_CMC_CLCL_CLAIM CLCL ON CLMD.CLCL_ID = CLCL.CLCL_ID AND CLCL.CLCL_LOW_SVC_DT > DATEADD(MONTH, - 6, GETDATE()) INNER JOIN ODW.DW.FAC_CMC_SBSB_SUBSC SBSB ON CLCL.SBSB_CK = SBSB.SBSB_CK"
