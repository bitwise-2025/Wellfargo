      "typeProperties" : {
        "scripts" : [ {
          "type" : "Query",
          "text" : "UPDATE L\nSET MEMBER_LANGUAGE_LANGUAGE = S.MEMBER_LANGUAGE_STAGING_LANGUAGE,\nMEMBER_LANGUAGE_CREATE_DT = GETDATE(),\nMEMBER_LANGUAGE_SRC_CREATE_DT = S.MEMBER_LANGUAGE_STAGING_CREATE_DT,\nMEMBER_LANGUAGE_SRC_CREATE_USER = S.MEMBER_LANGUAGE_STAGING_CREATE_USER\nFROM PDS_MEMBER_LANGUAGE L\nINNER JOIN PDS_MEMBER M ON L.MEMBER_LANGUAGE_MEMBER_IID = M.MEMBER_IID\nINNER JOIN PDS_MEMBER_LANGUAGE_STAGING S ON S.MEMBER_LANGUAGE_STAGING_MEMBERNUMBER = M.MEMBER_MEMBERNUMBER\nGO\n\nINSERT INTO [dbo].[PDS_MEMBER_LANGUAGE]\n           ([MEMBER_LANGUAGE_MEMBER_IID]\n           ,[MEMBER_LANGUAGE_LANGUAGE]\n           ,[MEMBER_LANGUAGE_SRC_CREATE_DT]\n           ,[MEMBER_LANGUAGE_SRC_CREATE_USER])\nSELECT \nm.MEMBER_IID\n,s.MEMBER_LANGUAGE_STAGING_LANGUAGE\n,s.MEMBER_LANGUAGE_STAGING_CREATE_DT\n,s.MEMBER_LANGUAGE_STAGING_CREATE_USER\nFROM dbo.PDS_MEMBER_LANGUAGE_STAGING s\ninner join dbo.PDS_MEMBER m\n  on m.MEMBER_MEMBERNUMBER = s.MEMBER_LANGUAGE_STAGING_MEMBERNUMBER\nLEFT OUTER JOIN PDS_MEMBER_LANGUAGE L ON L.MEMBER_LANGUAGE_MEMBER_IID = M.MEMBER_IID\nWHERE L.MEMBER_LANGUAGE_MEMBER_IID IS NULL"
        } ],
        "scriptBlockExecutionTimeout" : null
